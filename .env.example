BIDEXPERT_APP_NAME=BidExpert API
BIDEXPERT_APP_ENV=dev
BIDEXPERT_DATABASE_URL=sqlite+pysqlite:///./bidexpert.db
BIDEXPERT_MIN_MATRIX_COVERAGE=0.95

BIDEXPERT_REDIS_URL=redis://localhost:6379/0
BIDEXPERT_CELERY_BROKER_URL=redis://localhost:6379/0
BIDEXPERT_CELERY_RESULT_BACKEND=redis://localhost:6379/1

BIDEXPERT_QDRANT_URL=http://localhost:6333
BIDEXPERT_QDRANT_COLLECTION=expert_chunks_v1
BIDEXPERT_QDRANT_VECTOR_SIZE=3072
BIDEXPERT_QDRANT_HYBRID_CANDIDATE_LIMIT=128
BIDEXPERT_QDRANT_RRF_K=60
BIDEXPERT_QDRANT_ENABLE_RERANK=true
BIDEXPERT_QDRANT_RERANK_CANDIDATE_LIMIT=24
BIDEXPERT_QDRANT_LLM_RERANK_ENABLED=false
BIDEXPERT_QDRANT_LLM_RERANK_CANDIDATE_LIMIT=30
BIDEXPERT_QDRANT_LLM_RERANK_TOP_K=12

BIDEXPERT_LLM_HTTP_TIMEOUT_SECONDS=120
BIDEXPERT_LOG_LEVEL=INFO
# BIDEXPERT_LOG_FORMAT: json | plain
BIDEXPERT_LOG_FORMAT=json
BIDEXPERT_METRICS_ENABLED=true
# true 时允许无需鉴权直接访问 /metrics（生产建议 false）
BIDEXPERT_METRICS_PUBLIC_ENABLED=false

# BIDEXPERT_AUTH_MODE: api_key | jwt | hybrid
BIDEXPERT_AUTH_MODE=api_key
# 推荐生产使用 RS256/ES256（非对称密钥）
BIDEXPERT_JWT_PUBLIC_KEY_PEM=
BIDEXPERT_JWT_ALLOWED_ALGORITHMS=RS256,ES256
# 仅在必须兼容 HS256 时配置共享密钥
BIDEXPERT_JWT_SECRET=
BIDEXPERT_JWT_ISSUER=
BIDEXPERT_JWT_AUDIENCE=

BIDEXPERT_MAX_UPLOAD_BYTES=52428800
BIDEXPERT_API_RATE_LIMIT_ENABLED=true
BIDEXPERT_API_RATE_LIMIT_REQUESTS=300
BIDEXPERT_API_RATE_LIMIT_WINDOW_SECONDS=60

BIDEXPERT_UPLOAD_DIR=data/uploads
BIDEXPERT_SERVE_UI_STATIC=true
BIDEXPERT_EXPERT_LIBRARY_ROOT=data/tender-expert-lib
BIDEXPERT_RENDER_OUTPUT_DIR=data/exports
BIDEXPERT_RENDER_TEMPLATE_DIR=templates

BIDEXPERT_ENABLE_OCR_FALLBACK=true
# BIDEXPERT_OCR_PROVIDER: glm-ocr | textin | tesseract | hunyuan | docai
BIDEXPERT_OCR_PROVIDER=glm-ocr
BIDEXPERT_GLM_OCR_API_KEY=
BIDEXPERT_GLM_OCR_BASE_URL=
BIDEXPERT_GLM_OCR_MODEL=glm-ocr
BIDEXPERT_TEXTIN_OCR_API_KEY=
BIDEXPERT_TEXTIN_OCR_BASE_URL=https://api.textin.com/ai/service/v2/recognize/document
# TextIn 使用 x-ti-app-id，沿用 *_OCR_MODEL 字段存储
BIDEXPERT_TEXTIN_OCR_MODEL=
BIDEXPERT_HUNYUAN_OCR_API_KEY=
BIDEXPERT_HUNYUAN_OCR_BASE_URL=
BIDEXPERT_DOCAI_OCR_API_KEY=
BIDEXPERT_DOCAI_OCR_BASE_URL=

BIDEXPERT_SCHEMA_VERSION=v1.0
BIDEXPERT_TOP_K_DEFAULT=6
BIDEXPERT_EVIDENCE_EXPIRY_WARNING_DAYS=30
BIDEXPERT_PROJECT_TOKEN_BUDGET_DEFAULT=500000
BIDEXPERT_SECTION_MAX_INPUT_TOKENS=16000
BIDEXPERT_SECTION_MAX_OUTPUT_TOKENS=4000
BIDEXPERT_TASK_MAX_RETRIES=2
BIDEXPERT_TASK_MAX_FALLBACKS=1
BIDEXPERT_MAX_PARALLEL_SECTIONS=4
BIDEXPERT_TASK_STATUS_STREAM_TIMEOUT_SECONDS=300
BIDEXPERT_SEMANTIC_CACHE_CLEANUP_INTERVAL_SECONDS=300
BIDEXPERT_SEMANTIC_CACHE_MAX_LOCAL_ENTRIES=4096
BIDEXPERT_EVIDENCE_FUZZY_PARTIAL_RATIO_THRESHOLD=88
BIDEXPERT_PRICING_FILE=

BIDEXPERT_MASTER_KEY_B64=
BIDEXPERT_VAULT_ADDR=
BIDEXPERT_VAULT_TOKEN=
BIDEXPERT_VAULT_MOUNT=secret
BIDEXPERT_VAULT_NAMESPACE=
# 生产环境必须为 false，防止 VAULT 不可用时降级到 Redis
BIDEXPERT_VAULT_REDIS_FALLBACK_ENABLED=true
BIDEXPERT_SECRET_TEMP_KEY_TTL_SECONDS=3600

BIDEXPERT_API_KEY=
BIDEXPERT_OPENAI_API_KEY=
BIDEXPERT_OPENAI_BASE_URL=https://api.openai.com/v1
BIDEXPERT_GEMINI_API_KEY=
BIDEXPERT_GEMINI_BASE_URL=
BIDEXPERT_QWEN_API_KEY=
BIDEXPERT_QWEN_BASE_URL=
BIDEXPERT_DEEPSEEK_API_KEY=
BIDEXPERT_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
BIDEXPERT_VOYAGE_API_KEY=
BIDEXPERT_VOYAGE_BASE_URL=https://api.voyageai.com/v1

BIDEXPERT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BIDEXPERT_REVIEW_FALLBACK_PROVIDER=
BIDEXPERT_REVIEW_FALLBACK_MODEL=
BIDEXPERT_REVIEW_FALLBACK_BASE_URL=
BIDEXPERT_REVIEW_FALLBACK_API_KEY=
BIDEXPERT_REVIEW_ENSEMBLE_ENABLED=false
BIDEXPERT_REVIEW_ENSEMBLE_SIZE=3

BIDEXPERT_RL_ROUTING_ENABLED=false
BIDEXPERT_RL_ROUTING_EXPLORATION_RATE=0.1

BIDEXPERT_LANGEXTRACT_DEFAULT_MODEL=gemini-3-pro
BIDEXPERT_CONTEXT_COMPRESSION_USE_LLM=true
BIDEXPERT_CONTEXT_COMPRESSION_MAX_ITEMS=6
BIDEXPERT_CONTEXT_COMPRESSION_MAX_CHARS=4000
BIDEXPERT_CONTEXT_COMPRESSION_SNIPPET_CHARS=800

BIDEXPERT_EXPERT_CHUNK_MIN_TOKENS=800
BIDEXPERT_EXPERT_CHUNK_OVERLAP_TOKENS=120
