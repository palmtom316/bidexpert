BIDEXPERT_DATABASE_URL=sqlite+pysqlite:///./bidexpert.db
BIDEXPERT_MIN_MATRIX_COVERAGE=0.95
BIDEXPERT_REDIS_URL=redis://localhost:6379/0
BIDEXPERT_CELERY_BROKER_URL=redis://localhost:6379/0
BIDEXPERT_CELERY_RESULT_BACKEND=redis://localhost:6379/1
BIDEXPERT_QDRANT_URL=http://localhost:6333
BIDEXPERT_QDRANT_COLLECTION=expert_chunks_v1
BIDEXPERT_QDRANT_VECTOR_SIZE=256
BIDEXPERT_UPLOAD_DIR=data/uploads
BIDEXPERT_ENABLE_OCR_FALLBACK=true
BIDEXPERT_SCHEMA_VERSION=v3.2
BIDEXPERT_TOP_K_DEFAULT=6
BIDEXPERT_EVIDENCE_EXPIRY_WARNING_DAYS=30
BIDEXPERT_PROJECT_TOKEN_BUDGET_DEFAULT=500000
BIDEXPERT_SECTION_MAX_INPUT_TOKENS=16000
BIDEXPERT_SECTION_MAX_OUTPUT_TOKENS=4000
BIDEXPERT_TASK_MAX_RETRIES=2
BIDEXPERT_TASK_MAX_FALLBACKS=1
BIDEXPERT_MAX_PARALLEL_SECTIONS=4
BIDEXPERT_LANGEXTRACT_DEFAULT_MODEL=gemini-2.5-flash
